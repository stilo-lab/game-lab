# PFLICHT
DISCORD_TOKEN=PASTE_BOT_TOKEN_HERE
OWNER_ID=PASTE_YOUR_DISCORD_USER_ID_HERE

# OPTIONAL
BOT_NAME=Gaming Community Bot

# Optional: Testserver-ID für sofortige Guild-Slash-Commands
DEV_GUILD_ID=

# Optional: nur nötig, wenn du CLIENT_ID ausdrücklich selbst setzen möchtest
CLIENT_ID=

# Optional, aber für AI-Moderation / Schlichtung / Staff-AI nötig
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AI-Moderation / Streit-Schlichtung (Minuten)
# Eine einzelne erkannte Beleidigung löst NIE sofort diesen Timeout aus.
AI_INSULT_TIMEOUT_MIN=20
DISPUTE_DECLINE_TIMEOUT_MIN=30
DISPUTE_FAILED_TIMEOUT_MIN=30
DISPUTE_RESOLVED_TIMEOUT_MIN=10

# Optional: Fortnite Live News / Shop
FORTNITE_API_KEY=

COMMUNITY_TIMEZONE=Europe/Berlin
